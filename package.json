{
  "name": "notenblick",
  "version": "1.17.0",
  "private": true,
  "description": "Lokaler Windows-Notenrechner; Node-Abhängigkeiten ausschließlich für Entwicklungstests",
  "devDependencies": {
    "jsdom": "26.1.0",
    "axe-core": "4.14.0",
    "playwright": "1.62.1"
  },
  "scripts": {
    "setup": "python3 dev/manage.py setup",
    "test": "python3 dev/manage.py test changed",
    "test:full": "python3 dev/manage.py test full",
    "test:browser": "python3 dev/manage.py test browser",
    "build": "python3 dev/manage.py build",
    "release": "python3 dev/manage.py release",
    "test:quick": "python3 dev/manage.py test quick",
    "test:integration": "python3 dev/manage.py test changed --stage integration",
    "plan": "python3 dev/manage.py plan"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
